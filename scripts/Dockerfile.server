# Server image: the sandbox app on top of the multi-arch base.
# CI passes BASE_IMAGE=ghcr.io/<repo>/base:<sha> so server matches the base from
# the same run; locally it defaults to :latest (override with --build-arg).
ARG BASE_IMAGE=ghcr.io/swiss-ai/code-gym-sandbox/base:latest
FROM ${BASE_IMAGE}

# Qt5 + GMP/MPFR/MPC: needed so PyQt5 (and friends) build/run in the python runtime
# env on arches without a prebuilt wheel.
RUN apt-get update && apt-get install -y --no-install-recommends \
        qt5-qmake qtbase5-dev qtbase5-dev-tools \
        libqt5gui5 libqt5widgets5 libqt5core5a libqt5dbus5 \
        libgmp-dev libmpfr-dev libmpc-dev \
    && rm -rf /var/lib/apt/lists/*

# python runtime env (conda env "sandbox-runtime": PyQt5, torch, tensorflow, nltk data)
COPY ./runtime/python ./runtime/python
RUN conda create -n sandbox-runtime -y python=3.11 \
    && /bin/bash -c "source activate sandbox-runtime \
        && pip install --upgrade pip setuptools wheel \
        && pip install PyQt5==5.15.10 --config-settings --confirm-license= \
        && pip install -r ./runtime/python/requirements.txt --ignore-requires-python \
        && python -c 'import nltk; nltk.download(\"punkt\")' \
        && python -c 'import nltk; nltk.download(\"stopwords\")' \
        && pip cache purge" \
    && conda clean -afy && rm -rf /root/.cache
# fix pyqt error, see https://github.com/NVlabs/instant-ngp/discussions/300
ENV QT_QPA_PLATFORM=offscreen
ENV OMP_NUM_THREADS=2

# go runtime: warm the module/build cache
COPY ./runtime/go ./runtime/go
RUN cd ./runtime/go && go build

# node runtime + puppeteer/chrome shared libs (TODO: keep effective packages only)
COPY ./runtime/node /root/sandbox/runtime/node
RUN cd /root/sandbox/runtime/node && npm ci && npm cache clean --force \
    && apt-get update && apt-get install -y --no-install-recommends \
        fontconfig locales gconf-service libasound2 libatk1.0-0 libc6 libcairo2 \
        libcups2 libdbus-1-3 libexpat1 libfontconfig1 libgcc1 libgconf-2-4 \
        libgdk-pixbuf2.0-0 libglib2.0-0 libgtk-3-0 libnspr4 libpango-1.0-0 \
        libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 \
        libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 \
        libxss1 libxtst6 ca-certificates fonts-liberation libappindicator1 libnss3 \
        lsb-release xdg-utils libgbm-dev \
    && rm -rf /var/lib/apt/lists/*

# cache dotnet (warm the SDK/NuGet caches, then drop the throwaway project)
RUN dotnet new console -o /tmp/dotnet && dotnet run --project /tmp/dotnet && rm -rf /tmp/dotnet

# cache lean
COPY ./runtime/lean /root/sandbox/runtime/lean
RUN cd /root/sandbox/runtime/lean && lake build

# the app
COPY ./ /root/sandbox
WORKDIR /root/sandbox
RUN poetry config virtualenvs.create false \
    # TODO: find out why poetry throws error without this
    && touch /root/miniconda3/pyvenv.cfg \
    && poetry install \
    && cd ./docs && npm ci && npm run build \
    && rm -rf node_modules && npm cache clean --force

RUN useradd -m app && echo 'app:app' | chpasswd \
    && chmod og+rx /root \
    && mkdir -p /mnt \
    && chmod og+rwx /mnt

CMD bash /root/sandbox/scripts/run.sh
